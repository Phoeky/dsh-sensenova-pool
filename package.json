{
  "name": "dsh-sensenova-pool",
  "displayName": "DSH SenseNova Key Pool",
  "description": "商汤日日新（SenseNova）多 Key 轮换池 — 填入多把 Key 即可零配置接入 DeepSeek Harness，遇 429 限流自动切换下一把 Key。",
  "version": "0.1.1",
  "author": "Phoeky",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "sensenova",
    "日日新",
    "key-rotation",
    "key-pool",
    "rate-limit",
    "429",
    "model-provider"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phoeky/dsh-sensenova-pool.git"
  },
  "homepage": "https://github.com/Phoeky/dsh-sensenova-pool#readme",
  "bugs": "https://github.com/Phoeky/dsh-sensenova-pool/issues",
  "scripts": {
    "prepack": "npm run build",
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.json && node tools/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node tools/test-all.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@earendil-works/pi-ai": "^0.87.1"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
